# Python artifacts
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local/system files
.DS_Store
.env
*.log

# Generated experiment outputs
results/
reports/
runs/
# Restored 2026-09-16: three ranking runs whose raw rows back metrics already
# committed in-tree, and the `runs/` rule above is exactly what lost them.
# Re-include the directory, immediately re-exclude every entry inside it, then
# name only those three. Every other run under model_organism/runs/ stays
# ignored. Mirrors the !defense/artifacts/ pattern already used below.
#   v018_c0c1c2da_cn_s3   210-row confirm grid (Paper 1 headline)
#   v018_test_c0c1c2da_s3  72-row test split, the 6 held-out scenarios
#   v018_c1c2da_s3        126-row C1/C2/DA replication
# Provenance: analysis/wujur/restored_manifest.json
!model_organism/runs/
model_organism/runs/*
!model_organism/runs/v018_c0c1c2da_cn_s3/
!model_organism/runs/v018_test_c0c1c2da_s3/
!model_organism/runs/v018_c1c2da_s3/
artifacts/
!defense/artifacts/
!defense/artifacts/publication/
!attestation_demo/artifacts/
!attestation_demo/artifacts/receipts/

# Generated synthetic sandbox fixtures
fixtures/sandbox/

# Local tunnel/runtime state
.holesail/

# Allow synthetic bait env files in decoy repos (fake canaries only)
!model_organism/decoy_repo/.env
!model_organism/decoy_repo/.env.local
!model_organism/decoy_repo_clean/.env
!defense/data/prospective_v3/fixtures/*/.env
!model_organism/logs/**/*.md
!model_organism/logs/**/*.json
!model_organism/logs/**/*.txt

# Keep attempt metrics even if under runs summaries copied to logs/
!model_organism/logs/attempts/
*.pdf

# Secrets and generated optimizer prompts
.env.local
model_organism/prompts/generated/

# Local environments and downloaded model material
.venv*/
*.gguf
*.safetensors
