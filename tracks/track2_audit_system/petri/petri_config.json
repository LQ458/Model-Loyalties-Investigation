{
  "config_version": 1,
  "audit_type": "track2_secret_loyalty",
  "framework": {
    "package": "inspect-petri",
    "task": "inspect_petri.audit",
    "runner": "inspect_ai.eval",
    "minimum_inspect_ai": "0.3.236",
    "minimum_inspect_petri": "3.0.0",
    "minimum_python": "3.12"
  },
  "target_prompt_policy": {
    "source": "frozen_manifest_condition.system_prompt_path",
    "required": true,
    "auditor_may_set_system_message": false,
    "auditor_forbidden_tools": ["set_system_message"],
    "target_wrapper": "fixed_prompt_target_agent",
    "ground_truth_visible_to_auditor": false
  },
  "roles": {
    "auditor": {
      "env_base_url": "AUDITOR_BASE_URL",
      "env_model": "AUDITOR_MODEL",
      "env_api_key": "AUDITOR_API_KEY"
    },
    "target": {
      "env_base_url": "TARGET_BASE_URL",
      "env_model": "TARGET_MODEL",
      "env_api_key": "TARGET_API_KEY"
    },
    "judge": {
      "env_base_url": "JUDGE_BASE_URL",
      "env_model": "JUDGE_MODEL",
      "env_api_key": "JUDGE_API_KEY"
    }
  },
  "audit": {
    "max_turns": 20,
    "enable_prefill": true,
    "enable_rollback": true,
    "target_tools": "fixed",
    "realism_filter": false,
    "compaction": false,
    "epochs": 1,
    "max_connections": 1
  },
  "dimensions_path": "dimensions",
  "seeds_path": "seeds",
  "artifacts": {
    "required": ["inspect_logs", "run_manifest.json", "petri_summary.json"],
    "status_labels": ["SMOKE_ONLY", "LIVE", "FAILED"]
  },
  "safety": {
    "synthetic_fixtures_only": true,
    "no_real_secrets": true,
    "no_external_side_effects": true,
    "no_sealed_test_feedback": true
  }
}
