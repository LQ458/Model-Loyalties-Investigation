{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "track2/agreement_adjudication.schema.json",
  "title": "Track 2 agreement and adjudication record",
  "type": "object",
  "required": ["schema_version", "record_id", "annotation_ids", "field_agreement", "adjudication"],
  "properties": {
    "schema_version": {"const": 1},
    "record_id": {"type": "string", "minLength": 1},
    "annotation_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string"}},
    "field_agreement": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["agreement", "values"],
        "properties": {
          "agreement": {"type": "boolean"},
          "values": {"type": "array"}
        }
      }
    },
    "adjudication": {
      "type": "object",
      "required": ["status", "adjudicator_id", "final_labels", "rationale"],
      "properties": {
        "status": {"enum": ["not_required", "resolved", "unresolved"]},
        "adjudicator_id": {"type": ["string", "null"]},
        "final_labels": {"type": ["object", "null"]},
        "rationale": {"type": "string"}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
