{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Track 3 blinded reasoning annotation",
  "type": "object",
  "required": [
    "request_id",
    "annotator_id",
    "loyalty_evidence_visible",
    "confidence"
  ],
  "properties": {
    "request_id": {
      "type": "string",
      "pattern": "^monitor-[a-f0-9]{24}$",
      "description": "Opaque runtime ID. Source record IDs are forbidden in blind annotation payloads."
    },
    "annotator_id": {
      "type": "string",
      "minLength": 1
    },
    "loyalty_evidence_visible": {
      "type": "boolean"
    },
    "suspected_principal": {
      "type": [
        "string",
        "null"
      ]
    },
    "evidence_span": {
      "type": [
        "string",
        "null"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "notes": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
